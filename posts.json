<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Membaca Cerita...</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #fafafa; color: #333; margin: 0; padding: 20px; line-height: 1.6; }
        .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        .back-btn { text-decoration: none; color: #007bff; font-weight: bold; display: inline-block; margin-bottom: 20px; }
        .back-btn:hover { text-decoration: underline; }
        .cover-img { width: 100%; max-height: 400px; object-fit: cover; border-radius: 8px; margin-bottom: 20px; }
        .category { display: inline-block; padding: 4px 12px; background: #e0f7fa; color: #00796b; border-radius: 20px; font-size: 0.8em; font-weight: bold; }
        .title { font-size: 2.5em; margin: 10px 0; }
        .date { color: #888; margin-bottom: 30px; }
        .content { font-size: 1.1em; color: #444; }
    </style>
</head>
<body>
    <div class="container">
        <a href="index.html" class="back-btn">← Kembali ke Beranda</a>
        <div id="post-content-area">
            <p>Memuat cerita...</p>
        </div>
    </div>

    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const postId = urlParams.get('id');

        fetch('posts.json')
            .then(response => response.json())
            .then(posts => {
                const post = posts.find(p => p.id === postId);
                
                if (post) {
                    document.title = post.title + " - Dom's Journal";
                    const coverHTML = post.cover ? `<img src="${post.cover}" class="cover-img" alt="Cover">` : '';
                    
                    document.getElementById('post-content-area').innerHTML = `
                        ${coverHTML}
                        <span class="category">${post.category}</span>
                        <h1 class="title">${post.title}</h1>
                        <p class="date">${post.date}</p>
                        <hr style="border: 0; height: 1px; background: #eee; margin: 30px 0;">
                        <div class="content">
                            ${post.content}
                        </div>
                    `;
                } else {
                    document.getElementById('post-content-area').innerHTML = `<h2>Cerita tidak ditemukan.</h2>`;
                }
            })
            .catch(error => {
                document.getElementById('post-content-area').innerHTML = `<p>Terjadi kesalahan saat memuat cerita.</p>`;
            });
    </script>
</body>
</html>
